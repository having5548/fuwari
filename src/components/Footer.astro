---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
const startYear = 2024;
const buildYear = new Date().getFullYear();
---

  
<!--<div class="border-t border-[var(&#45;&#45;primary)] mx-16 border-dashed py-8 max-w-[var(&#45;&#45;page-width)] flex flex-col items-center justify-center px-6">-->
<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<!--<div class="transition bg-[oklch(92%_0.01_var(&#45;&#45;hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{startYear}{buildYear > startYear ? ` - ${buildYear}` : ''}</span> {profileConfig.name}，采用
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> 许可。
        <br>
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>网站地图</a> /
        <a class="transition link text-[var(--primary)] font-medium" href="/about-privacy/">关于 & 隐私政策</a>
        <br>
        由
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> 和
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a> 强力驱动
        <br>
        本网站代码
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/having5548/fuwari">已开源</a>
        <br>
        <a
            target="_blank"
            rel="noopener"
            href="https://www.itdog.cn/ping_ipv6/me.223910.xyz"
            title="本站支持 IPv6 访问，点击测试"
            class="group mt-3 inline-flex items-center gap-2 rounded-full bg-[var(--btn-regular-bg)] px-3 py-1 text-xs text-50 transition hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)]"
        >
            <span class="relative flex h-2 w-2 items-center justify-center">
                <span class="absolute h-2 w-2 rounded-full bg-[var(--primary)] opacity-25 transition group-hover:opacity-40"></span>
                <span class="relative h-1 w-1 rounded-full bg-[var(--primary)]"></span>
            </span>
            <span class="font-medium tracking-wide">IPv6</span>
            <span class="text-30 transition group-hover:text-[var(--primary)]">已支持 · 测速</span>
        </a>
    </div>
</div>

<script is:inline>
    // Astro 静态站点：构建时年份不会自动更新。
    // 这里用浏览器时间在访问时更新年份范围。
    (function () {
        const el = document.getElementById('copyright-year');
        if (!el) return;
        const startYear = 2024;
        const nowYear = new Date().getFullYear();
        el.textContent = nowYear > startYear ? `${startYear} - ${nowYear}` : String(startYear);
    })();
</script>
